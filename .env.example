# ===== 数据库 =====
DB_PASSWORD=postgres

# ===== Redis =====
REDIS_PASSWORD=redis

# ===== RabbitMQ =====
MQ_PASSWORD=guest

# ===== MinIO =====
MINIO_PASSWORD=minioadmin

# ===== LLM / Embedding API =====
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_DIMENSIONS=1536

# ===== RAG Query Rewrite / HyDE（默认关闭，真实评测时按需开启）=====
RAG_QUERY_REWRITE_ENABLED=false
RAG_HYDE_ENABLED=false

# ===== External Rerank（默认关闭，真实评测时按需开启）=====
RAG_RERANK_EXTERNAL_ENABLED=false
RAG_RERANK_API_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=bge-reranker-v2-m3

# ===== Evaluation LLM-as-judge（仅 benchmark/evaluation runner 使用）=====
EVALUATION_LLM_JUDGE_API_KEY=
EVALUATION_LLM_JUDGE_BASE_URL=https://api.openai.com/v1
EVALUATION_LLM_JUDGE_MODEL=gpt-4o-mini
